# Copie este arquivo para .env e ajuste os valores.
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).

# Chave usada para assinar o cookie de sessão e os tokens CSRF.
# Gere uma nova com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Caminho do banco SQLite (relativo à pasta do projeto)
DATABASE=instance/sorveteria.db

# Porta do servidor HTTPS
PORTA=5000

# Certificado e chave TLS (gerados por gerar_certificado.py)
CERT_ARQUIVO=certs/cert.pem
CHAVE_ARQUIVO=certs/key.pem
